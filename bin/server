#!/bin/bash
# bin/server install [--dry-run] [--accept-risk <row>]... | bin/server status: this Ubuntu machine as a hub host (story V2;
# `ade server install` and `ade server status` run it). Contract: .ade/context/server.md.
# install (as a normal user with sudo, never root; over SSH):
#   1. the host's safety, one row each, read-only: ssh-password (SSH password login off), ssh-root (root login off),
#      firewall (ufw active, allowing SSH only), upgrades (unattended security upgrades on). A failing row stops the
#      install before anything changes, unless it is accepted with --accept-risk <row> (repeatable);
#   2. the missing packages of a fixed list (apt; the distribution's versions), then the missing tools at pinned
#      versions (server_pin): gitleaks (checksum-verified, ~/.local/bin), bun, Claude Code (their own installers),
#      Playwright's Chromium with its system dependencies (story V3);
#      what is already there is left alone, so a rerun changes nothing;
#   3. the code folder (AGENT_CODE_DIR, default ~/Project; bin/work clones each checkout there on first use) and the
#      hub's scheduled jobs (bin/schedule install, when any job is absent);
#   4. the one manual step: sign Claude Code in over SSH (the Pro or Max login), then bin/keys set telegram.
#   Nothing listens on a public port: Telegram, Remote Control and git all connect out.
#   --dry-run prints every command that would change the machine (lines starting "+ ") and changes nothing; it exits
#   as the install would (1 when a safety row fails).
# status: services, last sync, last monitor run, disk space, the browser; never a secret.
# Exit: 0 done, 1 unsafe or a step failed, 2 usage, root, no sudo or not Linux.
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"
USAGE="usage: bin/server install [--dry-run] [--accept-risk ssh-password|ssh-root|firewall|upgrades]... | bin/server status"
ROWS="ssh-password ssh-root firewall upgrades"
# the fixed package list (apt) and the pinned tool versions
# (xvfb x11vnc novnc websockify: the SSH-tunnelled sign-in view of bin/browser login, story V3)
server_packages() { echo "git python3 tmux curl ca-certificates nodejs npm ufw unattended-upgrades xvfb x11vnc novnc websockify"; }
server_pin() { case "$1" in gitleaks) echo 8.30.1 ;; bun) echo 1.3.9 ;; claude) echo 2.1.330 ;; playwright) echo 1.64.1 ;; *) return 1 ;; esac; }
DRY=0; ACCEPT=" "
run() { if [ "$DRY" = 1 ]; then printf '+'; printf ' %q' "$@"; echo; else "$@"; fi; }
row() { printf '%-9s %-13s %s\n' "$1" "$2" "$3"; }
need_linux() { [ "$(platform)" = linux ] || { echo "server: this sets up an Ubuntu server; this machine is $(platform)" >&2; exit 2; }; }

safety() {   # prints the rows; returns 1 when a row fails and is not accepted
  local bad=0 r st why sshd ufws
  sshd="$(sudo -n sshd -T 2>/dev/null)" || sshd=""
  ufws="$(sudo -n ufw status 2>/dev/null)" || ufws=""
  for r in $ROWS; do
    st=OK; why=""
    case "$r" in
      ssh-password) printf '%s\n' "$sshd" | grep -qix 'passwordauthentication no' || { st=FAIL; why="SSH allows password login (PasswordAuthentication no in /etc/ssh/sshd_config)"; } ;;
      ssh-root) printf '%s\n' "$sshd" | grep -qix 'permitrootlogin no' || { st=FAIL; why="SSH allows root login (PermitRootLogin no in /etc/ssh/sshd_config)"; } ;;
      firewall) if ! printf '%s\n' "$ufws" | grep -qi '^status: active'; then st=FAIL; why="ufw is not active (sudo ufw allow OpenSSH && sudo ufw enable)"
        else why="$(printf '%s\n' "$ufws" | awk 'toupper($0) ~ /ALLOW/ {t=$1; if ($2 == "(v6)") t=t" "$2; if (t !~ /^(22|22\/tcp|OpenSSH)( \(v6\))?$/) print t}' | tr '\n' ' ')"
          [ -z "$why" ] || { st=FAIL; why="ufw allows more than SSH: $why"; }; fi ;;
      upgrades) { [ "$(systemctl is-enabled unattended-upgrades 2>/dev/null)" = enabled ] &&
          grep -qE '^[[:space:]]*APT::Periodic::Unattended-Upgrade[[:space:]]+"1"' "${AGENT_APT_CONF_DIR:-/etc/apt/apt.conf.d}/20auto-upgrades" 2>/dev/null; } ||
          { st=FAIL; why="unattended security upgrades are off (sudo dpkg-reconfigure -plow unattended-upgrades)"; } ;;
    esac
    [ "$st" = OK ] && why="${why:-on}"
    if [ "$st" = FAIL ]; then case "$ACCEPT" in *" $r "*) st=ACCEPTED ;; *) bad=1 ;; esac; fi
    row "$st" "$r" "$why"
  done
  return "$bad"
}
apt_missing() { local p m=""; for p in $(server_packages); do dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'ok installed' || m="$m $p"; done; echo "${m# }"; }
have() { command -v "$1" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$1" ] || [ -x "$HOME/.bun/bin/$1" ]; }
sha256() { if command -v sha256sum >/dev/null; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }
install_gitleaks() {   # the release tarball and its checksums file, verified, into ~/.local/bin
  local v a t; v="$(server_pin gitleaks)"; case "$(uname -m)" in x86_64|amd64) a=x64 ;; aarch64|arm64) a=arm64 ;; *) echo "server: no gitleaks build for $(uname -m)" >&2; return 1 ;; esac
  local f="gitleaks_${v}_linux_${a}.tar.gz" u="https://github.com/gitleaks/gitleaks/releases/download/v$v"
  if [ "$DRY" = 1 ]; then run curl -fsSL -o "<tmp>/$f" "$u/$f"; run curl -fsSL -o "<tmp>/sums" "$u/gitleaks_${v}_checksums.txt"; run tar -xzf "<tmp>/$f" -C "$HOME/.local/bin" gitleaks; return 0; fi
  t="$(mktemp -d)" || return 1
  curl -fsSL -o "$t/$f" "$u/$f" && curl -fsSL -o "$t/sums" "$u/gitleaks_${v}_checksums.txt" &&
    ( cd "$t" && w="$(awk -v f="$f" '$2 == f && $1 ~ /^[0-9a-f]+$/ && length($1) == 64 {print $1}' sums)" && [ -n "$w" ] && [ "$(sha256 "$f" | awk '{print $1}')" = "$w" ] ) &&
    mkdir -p "$HOME/.local/bin" && tar -xzf "$t/$f" -C "$HOME/.local/bin" gitleaks ||
    { echo "server: gitleaks $v could not be fetched or did not match its checksum" >&2; rm -rf "$t"; return 1; }
  rm -rf "$t"
}

case "${1:-}" in
  install) shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --dry-run) DRY=1; shift ;;
        --accept-risk) [ $# -ge 2 ] && case " $ROWS " in *" $2 "*) true ;; *) false ;; esac || { echo "server: --accept-risk takes one of: $ROWS" >&2; exit 2; }
          ACCEPT="$ACCEPT$2 "; shift 2 ;;
        *) echo "$USAGE" >&2; exit 2 ;;
      esac
    done
    need_linux
    [ "$(id -u)" != 0 ] || { echo "server: never as root; run it as the normal user the hub runs as (with sudo)" >&2; exit 2; }
    command -v sudo >/dev/null 2>&1 && sudo -v 2>/dev/null || { echo "server: needs a user with sudo (sudo -v failed)" >&2; exit 2; }
    git -C "$H" rev-parse --git-dir >/dev/null 2>&1 || { echo "server: $H is not a git checkout of the hub (ade server install clones it)" >&2; exit 2; }
    echo "== safety"
    SAFE=0; safety || SAFE=1
    if [ "$SAFE" = 1 ]; then
      echo "server: the host is not safe to run the hub; fix each FAIL row, or accept it with --accept-risk <row>" >&2
      [ "$DRY" = 1 ] || exit 1
      echo "(dry run: the install would stop here; the rest is what it would do once safe)"
    fi
    echo "== packages"
    m="$(apt_missing)"
    if [ -n "$m" ]; then run sudo apt-get update -q && run sudo apt-get install -y -q --no-install-recommends $m || { echo "server: apt-get install failed" >&2; exit 1; }
    else echo "all present: $(server_packages)"; fi
    echo "== tools"
    if have gitleaks; then echo "gitleaks: present"; else install_gitleaks || exit 1; fi
    if have bun; then echo "bun: present"; else run bash -c "curl -fsSL https://bun.sh/install | bash -s bun-v$(server_pin bun)" || { echo "server: bun install failed" >&2; exit 1; }; fi
    if have claude; then echo "claude: present"; else run bash -c "curl -fsSL https://claude.ai/install.sh | bash -s $(server_pin claude)" || { echo "server: Claude Code install failed" >&2; exit 1; }; fi
    # the browser (story V3): Playwright's Chromium, headless, and its system libraries (Playwright runs sudo apt-get)
    if browser_chromium >/dev/null; then echo "chromium: present"
    else run npx -y "playwright@$(server_pin playwright)" install --with-deps chromium || { echo "server: Chromium install failed" >&2; exit 1; }; fi
    echo "== hub"
    CD="${AGENT_CODE_DIR:-$HOME/Project}"
    if [ -d "$CD" ]; then echo "code folder: $CD"; else run mkdir -p "$CD" || exit 1; fi
    # the jobs: installed when any is absent (bin/schedule install refreshes them after a hub update)
    if [ "$DRY" = 0 ] && ! "$H/bin/schedule" status 2>/dev/null | grep -q '^absent'; then echo "scheduled jobs: installed (bin/schedule install refreshes them)"
    else run "$H/bin/schedule" install || { echo "server: bin/schedule install failed" >&2; exit 1; }; fi
    echo "== one manual step, over SSH on this machine"
    echo "  1. claude            sign in with your Pro or Max login (Claude Code prints a link to open on your own computer)"
    echo "  2. $H/bin/keys set telegram"
    echo "Nothing here listens on a public port: Telegram, Remote Control and git all connect out."
    exit "$([ "$DRY" = 1 ] && echo "$SAFE" || echo 0)" ;;
  status) [ $# -eq 1 ] || { echo "$USAGE" >&2; exit 2; }
    L="$(state_dir)/logs"
    when() { local t; [ -f "$1" ] && t="$(file_mtime "$1")" && [ -n "$t" ] && python3 -c 'import sys, time; print(time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(int(sys.argv[1]))))' "$t" || echo never; }
    echo "== services"; "$H/bin/schedule" status 2>/dev/null | sed 's/^/  /'
    row "" "last sync" "$(when "$L/sync.log")"
    row "" "last monitor" "$(when "$L/monitor.log")"
    d="$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {printf "%.1f GB free of %.1f GB (%s used)", $4/1048576, $2/1048576, $5}')"
    row "" "disk" "${d:-unknown}"
    if c="$(browser_chromium)"; then row "" "browser" "ready (headless Chromium, $c)"; else row "" "browser" "missing (bin/server install)"; fi ;;
  *) echo "$USAGE" >&2; exit 2 ;;
esac

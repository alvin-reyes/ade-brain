#!/bin/bash
# bin/session-end <folder>: SessionEnd hook (no model). Journals the commits made during the session, then
# commits that folder's hub files and the journal to the hub (only those paths; never pushes; `bin/sync` pushes).
# Reads the hook JSON on stdin; session start = first transcript line's timestamp, else the last 8 hours.
# Writes nothing when no repo has commits since then. Always exits 0.
. "$(dirname "$0")/lib.sh"; H="$(hub_root)"; F="${1:-.}"
in=$(cat 2>/dev/null); now=$(date +%s)
tp=$(printf '%s' "$in" | sed -n 's/.*"transcript_path"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
start=""
if [ -n "$tp" ] && [ -f "$tp" ]; then
  ts=$(head -1 "$tp" | sed -n 's/.*"timestamp"[ ]*:[ ]*"\([0-9T:-]*\).*/\1/p')
  [ -n "$ts" ] && start=$(date -j -u -f "%Y-%m-%dT%H:%M:%S" "$ts" +%s 2>/dev/null)
fi
[ -n "$start" ] || start=$((now - 8*3600))
commits=""; pushed=""
while IFS= read -r r; do
  [ -n "$r" ] || continue
  c=$(git -C "$r" log --since="$start" --oneline -10 2>/dev/null | tr '\n' '|' | sed 's/|$//; s/|/, /g')
  [ -n "$c" ] || continue
  commits="$commits${commits:+; }$(basename "$r"): $c"
  p=$(git -C "$r" for-each-ref --format='%(committerdate:unix) %(refname:short)' refs/remotes 2>/dev/null |
    awk -v s="$start" '$1>=s && $2!~/\/HEAD$/{print $2}' | tr '\n' ' ')
  [ -n "$p" ] && pushed="$pushed${pushed:+; }$(basename "$r"): ${p% }"
done <<EOR
$(repos_of "$F")
EOR
commit_folder() {
  [ "$F" = . ] && return 0
  cd "$H" || return 0
  [ -n "$(git status --porcelain -- "$F" journal 2>/dev/null)" ] || return 0
  git add -- "$F" journal 2>/dev/null
  local fs=(); while IFS= read -r x; do fs+=("$x"); done < <(git diff --cached --name-only -- "$F" journal)
  [ ${#fs[@]} -gt 0 ] && git commit -q -m "session $F $(date -u '+%Y-%m-%d %H:%M')" -- "${fs[@]}" >/dev/null 2>&1
  return 0
}
refresh_brain() { [ -x "$H/bin/brain" ] && timeout 120 "$H/bin/brain" index >/dev/null 2>&1; return 0; }
[ -n "$commits" ] || { refresh_brain; commit_folder; exit 0; }
files=$(find "$H/$F" -type f -not -path '*/.git/*' -mmin "-$(( (now - start) / 60 + 1 ))" 2>/dev/null | sed "s#^$H/$F/##" | head -10 | tr '\n' ',' | sed 's/,$//; s/,/, /g')
"$(dirname "$0")/journal" "$F" "auto: session ended; commits: $commits${pushed:+; branches pushed: $pushed}; changed files in folder: ${files:-none}"
refresh_brain
commit_folder
exit 0

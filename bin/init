#!/bin/bash
# bin/init: turn this template into a hub for one persona and client.
#   bin/init --persona <slug> --client "<name>" --owner "<name>" [--name <hub-name>] [--dest <dir>]
#            [--folders "projects/a ops/b"] [--repo owner/name[=~/checkout]]... [--code-owner <gh org>]
#            [--remote user@host[:port]] [--remote-key <path>] [--remote-dir <dir>] [--staging-url <url>]
#            [--secret <name>]... [--briefing HH:MM] [--claude <cmd>] [--claude-config-dir <dir>]
#            [--model M] [--effort low|medium|high|xhigh|max] [--agent-model M] [--subagent-model M] [--briefing-model M]
#            [--brain-path <dir>]... [--embed-model M] [--ollama-url URL] [--auto-sync on|off]
#            [--root-model M] [--compact-window N] [--bash-max-chars N]   (token limits; 0 or "" = Claude's default)
#   bin/init --list   the personas
# --dest copies the template to a new directory first (it must not exist); without it, initializes in place.
# Never overwrites an initialized hub (one with hub.conf). Writes no secrets: only names and locations.
set -u; T="$(cd "$(dirname "$0")/.." && pwd)"; . "$T/bin/lib.sh"
usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
fm() { awk -v k="$2" -F': ' '/^---$/{n++; next} n==1 && $1==k {sub(/^[^:]*: /,""); print; exit}' "$1"; }
if [ "${1:-}" = --list ]; then for p in "$T"/personas/*.md; do printf '%-28s %s\n' "$(basename "$p" .md)" "$(fm "$p" title)"; done; exit 0; fi
PERSONA=""; CLIENT=""; OWNER=""; NAME=""; DEST=""; FOLDERS=""; REPOS=(); CODE_OWNER=""; REMOTE=""; RKEY=""; RDIR=""
STAGING=""; SECRETS=(); BRIEF="08:00"; CLAUDE_CMD="claude"; CFG=""; MODEL=""; EFFORT=""; AMODEL="sonnet"; SMODEL="sonnet"; BMODEL="haiku"; BPATHS=(); EMODEL="nomic-embed-text"; OURL="http://localhost:11434"; ASYNC="on"; RMODEL="sonnet"; CWIN=200000; BMAX=8000
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage
  case "$1" in
    --persona) PERSONA="$2";; --client) CLIENT="$2";; --owner) OWNER="$2";; --name) NAME="$2";; --dest) DEST="$2";;
    --folders) FOLDERS="$2";; --repo) REPOS+=("$2");; --code-owner) CODE_OWNER="$2";; --remote) REMOTE="$2";;
    --remote-key) RKEY="$2";; --remote-dir) RDIR="$2";; --staging-url) STAGING="$2";; --secret) SECRETS+=("$2");;
    --briefing) BRIEF="$2";; --claude) CLAUDE_CMD="$2";; --claude-config-dir) CFG="$2";; --model) MODEL="$2";;
    --effort) EFFORT="$2";; --agent-model) AMODEL="$2";; --subagent-model) SMODEL="$2";; --briefing-model) BMODEL="$2";; --brain-path) BPATHS+=("$2");; --root-model) RMODEL="$2";; --compact-window) CWIN="$2";; --bash-max-chars) BMAX="$2";;
    --embed-model) EMODEL="$2";; --ollama-url) OURL="$2";; --auto-sync) ASYNC="$2";; *) usage;;
  esac; shift 2
done
[ -n "$PERSONA" ] && [ -n "$CLIENT" ] && [ -n "$OWNER" ] || usage
P="$T/personas/$PERSONA.md"; [ -f "$P" ] || { echo "init: no persona '$PERSONA' (bin/init --list)" >&2; exit 2; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }
[ -n "$NAME" ] || NAME="$(slugify "$CLIENT")-$PERSONA"
[[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "init: --name must be a-z 0-9 -" >&2; exit 2; }
[[ "$BRIEF" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "init: --briefing must be HH:MM" >&2; exit 2; }
[[ "$CLAUDE_CMD" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "init: bad --claude command" >&2; exit 2; }
for s in ${SECRETS[@]+"${SECRETS[@]}"}; do [[ "$s" =~ ^[a-z0-9-]+$ ]] || { echo "init: secret names are a-z 0-9 - (names only, never values)" >&2; exit 2; }; done
TITLE="$(fm "$P" title)"; [ -n "$MODEL" ] || MODEL="$(fm "$P" model)"; [ -n "$FOLDERS" ] || FOLDERS="$(fm "$P" folders)"; FOCUS="$(fm "$P" briefing_focus)"
[ -n "$SMODEL" ] || SMODEL="sonnet"
for m in "$MODEL" "$AMODEL" "$BMODEL" "$EMODEL"; do [ -z "$m" ] || [[ "$m" =~ ^[A-Za-z0-9._:/-]+$ ]] || { echo "init: bad model name '$m'" >&2; exit 2; }; done
# the subagent model may carry a context suffix such as sonnet[1m] (the same check as bin/work's SUBRE)
SUBRE='^[][A-Za-z0-9._:/-]+$'; [[ "$SMODEL" =~ $SUBRE ]] || { echo "init: bad model name '$SMODEL'" >&2; exit 2; }
[ -z "$RMODEL" ] || [[ "$RMODEL" =~ $SUBRE ]] || { echo "init: bad model name '$RMODEL'" >&2; exit 2; }
# token limits (.ade/context/model-defaults.md): 0 leaves Claude's default; Claude Code takes 100000-1000000 for the window
[[ "$CWIN" =~ ^[0-9]+$ ]] && { [ "$CWIN" = 0 ] || { [ "$CWIN" -ge 100000 ] && [ "$CWIN" -le 1000000 ]; }; } ||
  { echo "init: --compact-window must be 0 or 100000-1000000 tokens" >&2; exit 2; }
[[ "$BMAX" =~ ^[0-9]+$ ]] && { [ "$BMAX" = 0 ] || { [ "$BMAX" -ge 1000 ] && [ "$BMAX" -le 150000 ]; }; } ||
  { echo "init: --bash-max-chars must be 0 or 1000-150000 characters" >&2; exit 2; }
case "$ASYNC" in on|off) ;; *) echo "init: --auto-sync must be on or off" >&2; exit 2 ;; esac
case "$EFFORT" in ""|low|medium|high|xhigh|max) ;; *) echo "init: --effort must be low|medium|high|xhigh|max" >&2; exit 2 ;; esac
# the install's config dir: --claude-config-dir, else the CLAUDE_CONFIG_DIR its wrapper exports, else ~/.claude
if [ -z "$CFG" ]; then CFG="$(wrapper_config_dir "$CLAUDE_CMD")"; [ -n "$CFG" ] || CFG="$HOME/.claude"; fi
for f in $FOLDERS; do [[ "$f" =~ ^(projects|ops)/[a-z0-9-]+$ ]] || { echo "init: bad folder '$f'" >&2; exit 2; }; done
H="$T"
if [ -n "$DEST" ]; then
  [ -e "$DEST" ] && { echo "init: $DEST already exists" >&2; exit 2; }
  mkdir -p "$DEST" && H="$(cd "$DEST" && pwd)"
  (cd "$T" && tar cf - --exclude ./.git --exclude ./hub.conf --exclude ./repos --exclude ./_bmad-output .) | (cd "$H" && tar xf -)
fi
[ -f "$H/hub.conf" ] && { echo "init: $H is already initialized (hub.conf exists)" >&2; exit 2; }
# the persona text, with client and owner filled in
# (python, not sed: a name with & or # would be read as sed syntax)
PERSONA_TEXT="$(awk '/^---$/{n++; next} n>=2' "$P" | CLIENT="$CLIENT" OWNER="$OWNER" python3 -c 'import os, sys
print(sys.stdin.read().replace("{{CLIENT}}", os.environ["CLIENT"]).replace("{{OWNER}}", os.environ["OWNER"]), end="")')"
render() {  # template output: fill placeholders (multi-line values via python, so no sed escaping problems)
  NAME="$NAME" TITLE="$TITLE" CLIENT="$CLIENT" OWNER="$OWNER" PERSONA="$PERSONA_TEXT" SLUG="$PERSONA" MODEL="${MODEL:-inherit}" \
  REPO_ROWS="$REPO_ROWS" REMOTE_TXT="$REMOTE_TXT" STAGING_TXT="${STAGING:-none}" SECRETS_TXT="$SECRETS_TXT" FOLDER_LIST="$FOLDER_LIST" \
  python3 - "$1" "$2" <<'PY'
import os, sys
s = open(sys.argv[1]).read()
for k, e in [("NAME","NAME"),("TITLE","TITLE"),("CLIENT","CLIENT"),("OWNER","OWNER"),("PERSONA","PERSONA"),("SLUG","SLUG"),("MODEL","MODEL"),
             ("REPO_ROWS","REPO_ROWS"),("REMOTE","REMOTE_TXT"),("STAGING","STAGING_TXT"),("SECRETS","SECRETS_TXT"),("FOLDER_LIST","FOLDER_LIST")]:
    s = s.replace("{{%s}}" % k, os.environ[e])
open(sys.argv[2], "w").write(s)
PY
}
RHOST=""; RUSER=""; RPORT=22
if [ -n "$REMOTE" ]; then
  [[ "$REMOTE" =~ ^(([A-Za-z0-9._-]+)@)?([A-Za-z0-9.-]+)(:([0-9]+))?$ ]] || { echo "init: --remote must be user@host[:port]" >&2; exit 2; }
  RUSER="${BASH_REMATCH[2]}"; RHOST="${BASH_REMATCH[3]}"; RPORT="${BASH_REMATCH[5]:-22}"
fi
REMOTE_TXT="none configured"; [ -n "$RHOST" ] && REMOTE_TXT="${RUSER:+$RUSER@}$RHOST port $RPORT${RKEY:+, key \`$RKEY\`}${RDIR:+, dir \`$RDIR\`}"
SECRETS_TXT="${SECRETS[*]+${SECRETS[*]}}"; [ -n "$SECRETS_TXT" ] || SECRETS_TXT="none yet"
REPO_ROWS=""; REPO_NAMES=""; FIRST_REPO_ROW=""
for r in ${REPOS[@]+"${REPOS[@]}"}; do
  slug="${r%%=*}"; co=""; [ "$slug" != "$r" ] && co="${r#*=}"
  [[ "$slug" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { echo "init: --repo must be owner/name[=checkout]" >&2; exit 2; }
  row="| $slug | $co | main | $OWNER | (fill in) |"; REPO_ROWS="$REPO_ROWS$row"$'\n'; REPO_NAMES="$REPO_NAMES $slug"
  [ -n "$FIRST_REPO_ROW" ] || FIRST_REPO_ROW="$row"
done
FOLDER_LIST=""; for f in $FOLDERS; do FOLDER_LIST="$FOLDER_LIST- \`$f\`"$'\n'; done
q() { printf '%q' "$1"; }
cat > "$H/hub.conf" <<CONF
# hub.conf: who this agent is and what it can reach (written by bin/init). Names and locations only, never secrets.
HUB_NAME=$(q "$NAME")
HUB_PERSONA=$(q "$PERSONA")
HUB_PERSONA_TITLE=$(q "$TITLE")
HUB_CLIENT=$(q "$CLIENT")
HUB_OWNER=$(q "$OWNER")
HUB_CLAUDE=$(q "$CLAUDE_CMD")
HUB_CLAUDE_CONFIG_DIR=$(q "$CFG")
HUB_MODEL=$(q "$MODEL")
HUB_EFFORT=$(q "$EFFORT")
HUB_AGENT_MODEL=$(q "$AMODEL")
# fallback for subagents that name no model: bin/work sets CLAUDE_CODE_SUBAGENT_MODEL to it unless one is inherited (ADE's wins)
HUB_SUBAGENT_MODEL=$(q "$SMODEL")
HUB_BRIEFING_MODEL=$(q "$BMODEL")
HUB_CODE_OWNER=$(q "$CODE_OWNER")
HUB_REPOS=$(q "${REPO_NAMES# }")
HUB_REMOTE_HOST=$(q "$RHOST")
HUB_REMOTE_USER=$(q "$RUSER")
HUB_REMOTE_PORT=$(q "$RPORT")
HUB_REMOTE_KEY=$(q "$RKEY")
HUB_REMOTE_DIR=$(q "$RDIR")
HUB_STAGING_URL=$(q "$STAGING")
HUB_SECRETS=$(q "${SECRETS[*]+${SECRETS[*]}}")
HUB_KEYCHAIN_SERVICE=$(q "$NAME")
HUB_BRIEFING_HOUR=$(q "$((10#${BRIEF%%:*}))")
HUB_BRIEFING_MINUTE=$(q "$((10#${BRIEF##*:}))")
HUB_BRIEFING_FOCUS=$(q "$FOCUS")
HUB_TOOLS=""
HUB_BRAIN_PATHS=$(q "${BPATHS[*]+${BPATHS[*]}}")
HUB_EMBED_MODEL=$(q "$EMODEL")
HUB_OLLAMA_URL=$(q "$OURL")
# token limits: the hub root's model (its .claude/settings.json; a --model flag or ANTHROPIC_MODEL still wins), and the
# context window focus sessions and the hub root compact at and their inline Bash output cap (0 = Claude's default)
HUB_ROOT_MODEL=$(q "$RMODEL")
HUB_COMPACT_WINDOW=$(q "$CWIN")
HUB_BASH_MAX_CHARS=$(q "$BMAX")
# 1: bin/sync --auto pushes the hub every 30 minutes (bin/schedule) and at each focus session end; 0: off
HUB_AUTO_SYNC=$([ "$ASYNC" = off ] && echo 0 || echo 1)
CONF
render "$T/templates/hub/CLAUDE.md" "$H/CLAUDE.md"
render "$T/templates/hub/ACCESS.md" "$H/ACCESS.md"
render "$T/templates/hub/README.md" "$H/README.md"
mkdir -p "$H/.claude/agents" "$H/journal" "$H/memory" "$H/projects" "$H/ops"
render "$T/templates/hub/persona-agent.md" "$H/.claude/agents/$PERSONA.md"
# BMAD's project name and output folder (python: the hub path may hold & or #); a failure stops init, never silently
if [ -f "$H/_bmad/config.toml" ]; then
  python3 - "$H/_bmad/config.toml" "$NAME" "$H/_bmad-output" <<'PY' || { echo "init: could not write _bmad/config.toml" >&2; exit 1; }
import re, sys
p, name, out = sys.argv[1:]
q = lambda v: '"%s"' % v.replace("\\", "\\\\").replace('"', '\\"')
s = open(p).read()
s = re.sub(r"(?m)^project_name = .*$", lambda m: "project_name = " + q(name), s)
s = re.sub(r"(?m)^output_folder = .*$", lambda m: "output_folder = " + q(out), s)
open(p, "w").write(s)
PY
fi
# the hub root's settings: its model and token limits (keys, never an env block: an env value would replace ADE's)
python3 - "$H/.claude/settings.json" "$RMODEL" "$CWIN" "$BMAX" <<'PY' || { echo "init: could not write .claude/settings.json" >&2; exit 1; }
import json, sys
p, model, win, bmax = sys.argv[1:]
d = json.load(open(p))
out = {}
if model: out["model"] = model
if win != "0": out["autoCompactWindow"] = int(win)
if bmax != "0": out["bashOutputMaxChars"] = int(bmax)
for k, v in d.items():
    if k not in ("model", "autoCompactWindow", "bashOutputMaxChars"): out[k] = v
open(p, "w").write(json.dumps(out, indent=2) + "\n")
PY
[ -f "$H/memory/MEMORY.md" ] || printf '# Memory index (hub root: cross-folder facts)\n\n' > "$H/memory/MEMORY.md"
if [ ! -d "$H/.git" ]; then git -C "$H" init -q && git -C "$H" branch -M main 2>/dev/null; fi
git -C "$H" config core.hooksPath .githooks
for f in $FOLDERS; do HUB="$H" "$H/bin/new" "$f" >/dev/null || exit 1; done
# the first folder checks out the repos: deep work (bin/work <folder> [repo]) goes there; rows go inside its Code table
if [ -n "$REPO_ROWS" ]; then
  f1="${FOLDERS%% *}"; A="$H/$f1/ACCESS.md"
  ROWS="$REPO_ROWS" awk '{print} /^## Code/{c=1} c && /^\|---/{printf "%s", ENVIRON["ROWS"]; c=0}' "$A" > "$A.tmp" && mv "$A.tmp" "$A"
fi
HUB="$H" "$H/bin/journal" hub "Hub initialized from ade-brain: $TITLE for $CLIENT (owner $OWNER); folders: $FOLDERS" 
echo "initialized $NAME ($TITLE for $CLIENT) at $H"
echo "next: cd $H && bin/setup && bin/brain index && bin/doctor, then start $CLAUDE_CMD there"

#!/bin/bash
# bin/agent --role R --folder F: one read-only, headless task on the first model this hub may use for role R (bin/roles).
# The task comes on stdin, never argv. The report is printed between frame lines carrying a per-call nonce, capped at
# 20 KB (full text in .local/agent-out/). It is data: it approves nothing. No fallback once a run has started.
# AGENT_TIMEOUT: seconds (default 540, capped at 570). Exit 0 report; 1 run failed, timed out or was killed; 2 refused.
# Contract: .ade/context/providers.md, "Roles". The run itself is bin/agent.py.
# bin/agent --live-test <provider[:model]> [--dir D] (story H1, .ade/context/hub-interface.md): the same run with one tiny
# task (stdin's first line, else "Reply with the word READY and nothing else.") from a throwaway folder: D (exists, not a
# git checkout, not in the hub; the caller removes it) or a temp folder made and removed here. Model default haiku. Every
# check of a role run applies except HUB_PROVIDERS_ALLOWED (the live test is how a provider gets in). Exit 0 only when a
# whole output line is READY (spaces and CR ignored); 1 otherwise, the reason on the last line, keys hidden; 2 usage.
# An Anthropic run uses a stored Anthropic API key (bin/keys set anthropic) through apiKeyHelper, else the Claude login.
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"
USAGE="usage: bin/agent --role R --folder <projects|ops>/<name> < task | bin/agent --live-test <provider[:model]> [--dir <folder>]"
R=""; F=""; LT=""; D=""; LIVE=0; DIRSET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --role|--folder|--live-test|--dir) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 2; }
      case "$1" in --role) R="$2" ;; --folder) F="${2%/}" ;; --live-test) LT="$2"; LIVE=1 ;; --dir) D="$2"; DIRSET=1 ;; esac; shift 2 ;;
    *) echo "$USAGE" >&2; exit 2 ;;
  esac
done
T="${AGENT_TIMEOUT:-540}"; [[ "$T" =~ ^[1-9][0-9]*$ ]] || { echo "agent: AGENT_TIMEOUT must be a number of seconds" >&2; exit 2; }
if [ "${#T}" -gt 3 ] || [ "$T" -gt 570 ]; then T=570; fi
OWN=""
if [ "$LIVE" = 1 ]; then
  [ -z "$R" ] && [ -z "$F" ] && [ -n "$LT" ] && { [ "$DIRSET" = 0 ] || [ -n "$D" ]; } || { echo "$USAGE" >&2; exit 2; }
  # no provider key or backend switch from the caller's shell, whatever the engine's environment allowlist lets through
  for v in $(compgen -e); do case "$v" in ANTHROPIC_*|CLAUDE_CODE_OAUTH_TOKEN|CLAUDE_CODE_USE_*|*_API_KEY|*_AUTH_TOKEN|TELEGRAM_BOT_TOKEN) unset "$v" ;; esac; done
  [[ "$LT" =~ ^[a-z0-9-]+(:[][A-Za-z0-9._/-]+)?$ ]] || { echo "agent: bad provider '$LT' (provider or provider:model)" >&2; exit 2; }
  P="${LT%%:*}"; M=haiku; case "$LT" in *:*) M="${LT#*:}" ;; esac
  failed() { echo "agent: live test of $P:$M failed: $1" | redact >&2; exit 1; }
  case "$P" in
    anthropic) anthropic_model_ok "$M" || { echo "agent: '$M' is not an Anthropic model (opus, sonnet, haiku, optional [1m], or claude-*)" >&2; exit 2; } ;;
    gemini) failed "gemini has no Gemini CLI engine in this hub yet (story E1)" ;;
    *) provider_field "$P" base_url >/dev/null || { key_secret "$P" >/dev/null && failed "$P is not connected yet (no provider row in bin/lib.sh)"
         echo "agent: unknown provider '$P'" >&2; exit 2; } ;;
  esac
  if [ "$DIRSET" = 1 ]; then
    case "$D" in /*) ;; *) echo "agent: --dir must be an absolute path" >&2; exit 2 ;; esac
    [ -d "$D" ] || { echo "agent: no folder $D" >&2; exit 2; }
    DIR="$(cd "$D" && pwd -P)"; HR="$(cd "$H" && pwd -P)"
    case "$DIR/" in "$HR"/*) echo "agent: --dir must be a throwaway folder, not inside the hub" >&2; exit 2 ;; esac
    if git -C "$DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then echo "agent: --dir must be a throwaway folder, never a git checkout" >&2; exit 2; fi
  else
    DIR="$(mktemp -d "${TMPDIR:-/tmp}/agent-live.XXXXXX")" && DIR="$(cd "$DIR" && pwd -P)" || { echo "agent: cannot make a temp folder" >&2; exit 1; }
    OWN="$DIR"; trap 'rm -rf "$OWN"' EXIT
  fi
  why="$(HUB_PROVIDERS_ALLOWED="$P"; candidate_refusal "$P:$M" "$DIR" read)"; [ -z "$why" ] || failed "$why"
  R=live-test; F=-
else
  [ -n "$R" ] && [ -n "$F" ] && [ "$DIRSET" = 0 ] || { echo "$USAGE" >&2; exit 2; }
  [[ "$F" =~ ^(projects|ops)/[A-Za-z0-9._-]+$ ]] && [[ "$F" != */.* ]] && [ -f "$H/$F/ACCESS.md" ] || { echo "agent: no folder '$F'" >&2; exit 2; }
  DIR="$(repos_of "$F" | head -1)"; DIR="${DIR:-$H/$F}"
  role_pick "$R" "$DIR" read; s=$?
  [ "$s" != 2 ] || exit 2
  [ "$s" = 0 ] || { echo "agent: no usable model for role $R" >&2; printf '%s' "$ROLE_SKIPS" | sed 's/^/  /' >&2; exit 2; }
  [ -z "$ROLE_SKIPS" ] || printf '%s' "$ROLE_SKIPS" | sed 's/^/agent: /' >&2
  P="${ROLE_PICK%%:*}"; M="${ROLE_PICK#*:}"
fi
CL="$(claude_cmd)"; [[ "$CL" =~ ^[A-Za-z0-9._/-]+$ ]] && CL="$(command -v -- "$CL")" || { echo "agent: cannot find the claude command '$(claude_cmd)'" >&2; exit 2; }
# read-only and isolated: no hooks, MCP servers, skills, workspace settings or CLAUDE.md; file tools stay in the checkout.
# --safe-mode, not --bare: --bare never reads the Claude login, and on a provider run it offers only Read.
ARGS=(-p --output-format text --no-session-persistence --model "$M" --tools "Read,Grep,Glob" --safe-mode --restricted --strict-mcp-config --disable-slash-commands)
MS=""; CD=""
if [ "$P" = anthropic ]; then
  # The default config dir stays unset, because naming it explicitly makes Claude Code look for a different Keychain login.
  CD="$(claude_home)"; [ "${CD%/}" != "$HOME/.claude" ] || CD=""
  # a stored Anthropic API key: through apiKeyHelper only (never an environment variable); else the Claude login
  if "$H/bin/secret" --has "$(key_secret anthropic)" 2>/dev/null; then
    MS="$(mktemp "${TMPDIR:-/tmp}/agent-settings.XXXXXX")" && chmod 600 "$MS" && anthropic_settings_write "$MS" || { rm -f "$MS"; exit 2; }
    ARGS+=(--settings "$MS")
  fi
else
  PM="$(provider_model_var "$P")"; PS="$(provider_small_var "$P")"
  CD="$H/.local/providers/$P"; mkdir -p "$CD" || exit 2
  MS="$(mktemp "${TMPDIR:-/tmp}/agent-settings.XXXXXX")" && chmod 600 "$MS" || exit 2
  # secret files never go to the vendor (these Read rules also bind Grep and Glob); no deferred-tool stub in the tool list
  provider_settings_write <(python3 -c 'import json
names = [".env", ".env.*", "*.pem", "*.key", "id_rsa*", ".ssh/**", ".aws/**", ".npmrc", ".netrc", "credentials*", "secrets/**"]
print(json.dumps({"disableAllHooks": True, "env": {"ENABLE_TOOL_SEARCH": "false"}, "permissions": {"deny": ["Read(**/%s)" % n for n in names]}}))') "$MS" "$P" "$(provider_model_id "$P" "$M")" "$(provider_model_id "$P" "${!PS:-$(provider_field "$P" small)}")" || { rm -f "$MS"; exit 2; }
  ARGS+=(--settings "$MS")
fi
export AGENT_RUN_HUB="$H" AGENT_RUN_ROLE="$R" AGENT_RUN_FOLDER="$F" AGENT_RUN_PROVIDER="$P" AGENT_RUN_MODEL="$M" AGENT_RUN_DIR="$DIR" \
  AGENT_RUN_TIMEOUT="$T" AGENT_RUN_SETTINGS="$MS" AGENT_RUN_CONFIG_DIR="$CD" AGENT_RUN_LIVE="$LIVE"
[ -n "$OWN" ] || exec python3 "$(dirname "$0")/agent.py" "$CL" "${ARGS[@]}"
python3 "$(dirname "$0")/agent.py" "$CL" "${ARGS[@]}"   # not exec: the temp folder is removed after the run

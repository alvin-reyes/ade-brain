#!/bin/bash
# bin/gemini-run --system-settings FILE --auth google|key [gemini args...]: runs the Gemini CLI for bin/work (a focus
# session's launcher) and bin/agent (a delegated run), story E1. Contract: .ade/context/engines.md, "Gemini CLI engine".
# - yolo in any spelling is refused (exit 2), as bin/work and bin/agent refuse it, and FILE disables it again;
# - the caller's Gemini credentials and backend switches (gemini_scrub_vars) never reach the CLI;
# - FILE (the hub's layer, gemini_settings_write) becomes the CLI's system settings, which override the user's and the
#   checkout's settings;
# - auth google: the CLI's own Google login, no key handled; auth key: the stored gemini-api-key is read once (bin/secret)
#   and given to the CLI in its environment only (GEMINI_API_KEY, the one way the CLI takes a key): never in argv or a
#   file. A missing or empty key: exit 1 before the CLI starts. The CLI redacts it from its tools' children (FILE).
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"
USAGE="usage: bin/gemini-run --system-settings FILE --auth google|key [gemini args...]"
SET=""; AUTH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --system-settings) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 2; }; SET="$2"; shift 2 ;;
    --auth) [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 2; }; AUTH="$2"; shift 2 ;;
    *) break ;;
  esac
done
[ -n "$SET" ] && [ -f "$SET" ] || { echo "gemini-run: no settings file '$SET'; $USAGE" >&2; exit 2; }
case "$AUTH" in google|key) ;; *) echo "$USAGE" >&2; exit 2 ;; esac
why="$(gemini_yolo_refusal ${@+"$@"})"; [ -z "$why" ] || { echo "gemini-run: $why" >&2; exit 2; }
for v in $(gemini_scrub_vars); do unset "$v"; done
export GEMINI_CLI_SYSTEM_SETTINGS_PATH="$SET"
G="$(gemini_cmd)"; command -v -- "$G" >/dev/null 2>&1 || { echo "gemini-run: the Gemini CLI ($G) is not installed" >&2; exit 1; }
if [ "$AUTH" = google ]; then exec "$G" ${@+"$@"}; fi
k="$(HUB="$H" AGENT_KEYCHAIN_SERVICE="$(keychain_service)" "$H/bin/secret" gemini-api-key 2>/dev/null)" && [ -n "$k" ] ||
  { unset k; echo "gemini-run: $(gemini_auth_hint)" >&2; exit 1; }
GEMINI_API_KEY="$k" exec "$G" ${@+"$@"}

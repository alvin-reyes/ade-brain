#!/bin/bash
# bin/new <projects|ops>/<name>: a folder from templates/, plus its named agent. Never overwrites.
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"; F="${1:-}"
[[ "$F" =~ ^(projects|ops)/[a-z0-9-]+$ ]] || { echo "usage: bin/new projects/<name>|ops/<name> (a-z 0-9 -)" >&2; exit 2; }
NAME="${F#*/}"; AGENT="$(agent_name "$F")"
put() {  # template destination
  local dst="$H/$2"; if [ -e "$dst" ]; then echo "kept $2"; return; fi
  mkdir -p "$(dirname "$dst")"
  # python, not sed: an owner, title or hub path with & or # would be read as sed syntax
  P_FOLDER="$F" P_NAME="$NAME" P_AGENT="$AGENT" P_HUB="$H" P_TITLE="$(persona_title)" P_AGENT_MODEL="${HUB_AGENT_MODEL:-sonnet}" \
  P_HUBNAME="$(hub_name)" P_OWNER="$(hub_owner)" python3 - "$H/templates/$1" "$dst" <<'PY' || exit 1
import os, sys
s = open(sys.argv[1]).read()
for k in ("FOLDER", "NAME", "AGENT", "HUB", "TITLE", "AGENT_MODEL", "HUBNAME", "OWNER"):
    s = s.replace("{{%s}}" % k, os.environ["P_" + k])
open(sys.argv[2], "w").write(s)
PY
  echo "made $2"
}
put CLAUDE.md "$F/CLAUDE.md"; put ACCESS.md "$F/ACCESS.md"; put STATE.md "$F/STATE.md"
put MEMORY.md "$F/memory/MEMORY.md"; put folder-settings.json "$F/.claude/settings.json"; put agent.md ".claude/agents/$AGENT.md"
[ -x "$H/bin/setup" ] && "$H/bin/setup" >/dev/null
exit 0

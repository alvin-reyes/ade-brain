#!/bin/bash
# bin/chat start|stop|status|setup [channel]: the hub's orchestrator (its main session at the hub root) with its chat
# channels attached, so the owner can reach it from Telegram (story C5, ADR 0006). Contract: .ade/context/chat.md.
#   start   run claude at the hub root with --channels <plugin> for each HUB_CHANNELS type (default telegram), in
#           HUB_CHAT_MODE (default manual: every permission prompt goes to the owner) with Remote Control named
#           HUB_ORCHESTRATOR (default the hub name). One at a time. Without a terminal (launchd: bin/schedule install with
#           HUB_CHAT=telegram) it starts only when each channel's policy is allowlist with no groups.
#   stop    end it, and disable and unload the launchd job, which would restart it (bin/schedule install enables it again)
#   status  running or stopped, since when, whether the channel connected, and each channel's policy and group count
#           (never ids or the token)
#   setup   the one-time steps: bot, token, plugin, pairing, allowlist, a test message
# Story C7 (the orchestrator is the switchboard between the owner's chat and the focus agents):
#   status --card                 the status card: a title line, then one line per agent (● busy ○ idle ⚠ blocked)
#   agents                        the /agents table: name, folder, role, ticket, state
#   to --sender <id> <agent> <text>  one bin/notify from main to that agent's folder (an agent name, folder or folder
#                                 name among the running agents); unknown or ambiguous: exit 2 with the agents listed
#   forward                       send the agents' idle/ended/note events to main to the chat, tagged [<agent>], once
#                                 each (start runs it every AGENT_CHAT_FORWARD_EVERY s, default 15, 0 = never)
#   ask <question>                offer an approval: Approve/Deny buttons where the channel takes them, else "reply 1
#                                 to approve, 2 to deny (ref <ref>)"; prints the ref
#   answer --sender <id> <reply>  record the owner's answer (1, 2, approve, deny, optionally a ref; or a button's data)
#   asked <ref>                   pending, approved or denied
# --sender is the user_id of the inbound channel message: only a paired owner (access.json allowFrom) counts.
# Never skips permissions: dangerously/bypassPermissions in an argument, a HUB setting or the claude wrapper exits 2.
# Each channel's token goes from the Keychain (bin/secret) into a 0600 .env in that channel's own state folder, which a
# watcher deletes once the plugin has read it (it writes bot.pid), or after 60 s. Never the environment, argv or log.
set -u; . "$(dirname "$0")/lib.sh"; H="$(hub_root)"; S="$(state_dir)"; PIDF="$S/chat/chat.pid"; LOCK="$S/chat/lock"
LA="${AGENT_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}"; LABEL="ai.agent-hub.$(hub_name).chat"
NAME="${HUB_ORCHESTRATOR:-$(hub_name)}"
usage() { echo "usage: bin/chat start | stop | status [--card] | setup [channel] | agents | to --sender <id> <agent> <text> | forward | ask <question> | answer --sender <id> <reply> | asked <ref> (channels: $(channel_types))" >&2; exit 2; }
CHANNELS="${HUB_CHANNELS-telegram}"
check_channels() {
  [ -n "${CHANNELS// /}" ] || { echo "chat: HUB_CHANNELS is empty (known channel types: $(channel_types))" >&2; exit 2; }
  local c; for c in $CHANNELS; do case " $(channel_types) " in *" $c "*) ;;
    *) echo "chat: unknown channel type in HUB_CHANNELS (known channel types: $(channel_types))" >&2; exit 2 ;; esac; done
}
# channel_dir <channel>: this orchestrator's own state folder for it (two hubs never share a bot token or allowlist)
channel_dir() { echo "$S/channels/$1"; }
# is_session <pid>: a live process that is this hub's channel session (--channels and --remote-control <NAME>)
is_session() { ps -p "$1" -o command= 2>/dev/null | awk -v n="$NAME" '{for(i=1;i<NF;i++) if($i=="--remote-control" && $(i+1)==n) r=1} / --channels /{c=1} END{exit !(r&&c)}'; }
running_pid() { local p; [ -f "$PIDF" ] || return 1; p="$(awk '{print $1; exit}' "$PIDF")"
  case "$p" in ''|*[!0-9]*) return 1 ;; esac; is_session "$p" || return 1; echo "$p"; }
since() { awk '{print $2; exit}' "$PIDF"; }
# connected <channel>: the plugin wrote a bot.pid since this session started, and that process lives
connected() { local b; b="$(channel_dir "$1")/bot.pid"; [ -f "$b" ] && [ ! "$PIDF" -nt "$b" ] || return 1
  b="$(awk '{print $1; exit}' "$b")"; case "$b" in ''|*[!0-9]*) return 1 ;; esac; kill -0 "$b" 2>/dev/null; }
# access_of <channel>: "<policy> <groups>" from the plugin's access.json (policy only when a known name), else nothing
access_of() { local f; f="$(channel_dir "$1")/access.json"; [ -f "$f" ] || return 1
  python3 -I -c 'import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d=None
if not isinstance(d,dict): print("unknown unknown"); sys.exit(0)
v=d.get("dmPolicy", d.get("policy")); g=d.get("groups") or {}
print((v if v in ("pairing","allowlist","disabled") else "unknown"), (len(g) if isinstance(g,(dict,list)) else "unknown"))' "$f" 2>/dev/null; }
refuse_skip() { echo "chat: refused: the orchestrator never skips permissions ($1)" >&2; exit 2; }
skips() { case "$1" in *dangerously*|*bypassPermissions*) return 0 ;; esac; return 1; }
# the start lock: a folder holding the holder's pid; a holder that is gone, or is neither bin/chat nor a session, is stale
take_lock() { local p; mkdir -p "$S/chat" && chmod 700 "$S/chat" || return 1
  mkdir "$LOCK" 2>/dev/null && { echo $$ > "$LOCK/pid"; return 0; }
  p="$(cat "$LOCK/pid" 2>/dev/null)"; case "$p" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$p" 2>/dev/null && ps -p "$p" -o command= 2>/dev/null | grep -qE 'bin/chat|--channels' && return 1
  rm -rf "$LOCK"; mkdir "$LOCK" 2>/dev/null && echo $$ > "$LOCK/pid"; }
refuse() { rm -rf "$LOCK"; echo "chat: $1" >&2; exit "${2:-1}"; }
PY_CHAT="$(dirname "$0")/chat.py"; PY_EV="$(dirname "$0")/events.py"; ASKS="$S/chat/asks"
first_channel() { set -- $CHANNELS; echo "${1:-telegram}"; }
access_file() { echo "$(channel_dir "$(first_channel)")/access.json"; }
# is_owner <sender>: a paired owner of the chat channel (access.json allowFrom), else a refusal on stderr
is_owner() { [ -n "${1:-}" ] && ACCESS="$(access_file)" python3 -I "$PY_CHAT" owner "$1" && return 0
  echo "chat: ignored: not the paired owner (only a sender in the channel's allowlist counts)" >&2; return 1; }
# chat_send [--buttons <ref>]: the text on stdin to the paired owner, through the fake channel (AGENT_CHAT_SEND, tests)
# or the channel's bot (its token from the Keychain on the helper's stdin, never an argument or the environment)
chat_send() { local c t rc; c="$(first_channel)"
  if [ -n "${AGENT_CHAT_SEND:-}" ]; then ACCESS="$(access_file)" python3 -I "$PY_CHAT" send "$@"; return; fi
  t="$("$H/bin/secret" "$(channel_secret "$c")" 2>/dev/null)" && [ -n "$t" ] || { echo "chat: no $c bot token (bin/keys set $c)" >&2; return 1; }
  { printf '%s\n' "$t"; cat; } | ACCESS="$(access_file)" python3 -I "$PY_CHAT" send "$@"; rc=$?; unset t; return $rc; }
ev_py() { H="$H" ST="$S" python3 -I "$PY_EV" "$@"; }
agents_view() { local s; s="$("$H/bin/sessions" 2>/dev/null)" || { echo "chat: bin/sessions failed" >&2; return 1; }
  printf '%s\n' "$s" | LATEST="$(ev_py latest 2>/dev/null)" python3 -I "$PY_CHAT" agents "$1" "$2"; }
# resolve <agent>: the one folder among the running agents that the name names (agent name, folder, or folder name)
resolve() { "$H/bin/sessions" 2>/dev/null | awk -v t="$1" 'NR>1 && NF>=2 { n=$2; sub(/.*\//,"",n); if ($1==t || $2==t || n==t) f[$2]=1 }
  END { for (k in f) { c++; o=k } if (c==1) print o; exit c!=1 }'; }
pending() { local f; for f in "$ASKS"/*; do [ -f "$f" ] || continue; case "$f" in *.answer) continue ;; esac
  [ -f "$f.answer" ] || basename "$f"; done; }

case "${1:-}" in
  start) shift
    for a in "$@"; do skips "$a" && refuse_skip "argument $a"; done
    [ $# -eq 0 ] || usage
    for v in $(compgen -v | grep -E '^(HUB_|AGENT_CLAUDE$)'); do skips "${!v}" && refuse_skip "$v"; done
    CL="$(claude_cmd)"
    case "$CL" in *[[:space:]]*) echo "chat: the claude command must be one word (HUB_CLAUDE / AGENT_CLAUDE)" >&2; exit 2 ;; esac
    # best effort: a small wrapper script that names a skip flag is refused (a binary or an indirect wrapper is not seen)
    w="$(command -v -- "$CL" 2>/dev/null)"
    if [ -n "$w" ] && [ -f "$w" ] && [ "$(wc -c < "$w")" -lt 65536 ] && grep -qE 'dangerously|bypassPermissions' "$w" 2>/dev/null; then
      refuse_skip "the claude wrapper $CL"; fi
    MODE="${HUB_CHAT_MODE:-manual}"
    case "$MODE" in auto|manual|acceptEdits|plan) ;; *) echo "chat: mode must be auto|manual|acceptEdits|plan (HUB_CHAT_MODE)" >&2; exit 2 ;; esac
    [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "chat: HUB_ORCHESTRATOR must start with a letter or digit (letters, digits, . _ -)" >&2; exit 2; }
    [ -z "${HUB_MODEL:-}" ] || [[ "$HUB_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._:/\[\]-]*$ ]] || { echo "chat: bad HUB_MODEL" >&2; exit 2; }
    check_channels
    other="$(hub_name_claim)" || { echo "chat: the hub name $(hub_name) is already used by the hub at $other (same state folder, Keychain service and launchd label): set HUB_NAME in hub.conf" >&2; exit 2; }
    take_lock || { p="$(running_pid)" && { echo "chat: already running (pid $p, since $(since)); bin/chat stop first" >&2; exit 1; }
      echo "chat: another bin/chat start holds the lock $LOCK (pid $(cat "$LOCK/pid" 2>/dev/null)); if none runs, remove that folder" >&2; exit 1; }
    if p="$(running_pid)"; then refuse "already running (pid $p, since $(since)); bin/chat stop first"; fi
    command -v -- "$CL" >/dev/null 2>&1 || refuse "$CL not found"
    command -v bun >/dev/null 2>&1 || refuse "bun not found (the Telegram plugin runs on it: https://bun.sh, then ~/.bun/bin on PATH)"
    TTY=0; [ -t 0 ] && TTY=1
    for c in $CHANNELS; do unset "$(channel_token_env "$c")" "$(channel_state_env "$c")"
      # without a terminal nobody can watch a pairing: only an allowlist with no groups may run unattended
      if [ "$TTY" = 0 ]; then a="$(access_of "$c")" || refuse "$c is not paired yet: run bin/chat start in a Terminal first (bin/chat setup $c)"
        [ "$a" = "allowlist 0" ] || refuse "$c must be locked to an allowlist with no groups before it runs unattended (now: policy ${a% *}, groups ${a#* }): /telegram:access policy allowlist"; fi
      "$H/bin/secret" --has "$(channel_secret "$c")" || refuse "no $c bot token in the Keychain: run bin/keys set $c (bin/chat setup $c)"; done
    cmd=("$CL"); for c in $CHANNELS; do cmd+=(--channels "$(channel_plugin "$c")"); done
    cmd+=(--permission-mode "$MODE" --remote-control "$NAME"); [ -z "${HUB_MODEL:-}" ] || cmd+=(--model "$HUB_MODEL")
    CD="$(claude_home)"; [ "$CD" = "$HOME/.claude" ] || export CLAUDE_CONFIG_DIR="$CD"
    cd "$H" || refuse "cannot enter $H"
    # launchd gives no terminal, and claude's interface needs one: script(1) gives it a pseudo-terminal, fed a stdin
    # that never ends while this process lives (an end of input would reach claude as Ctrl-D)
    if [ "$TTY" = 0 ]; then exec 0< <(exec >/dev/null 2>&1; while kill -0 $$ 2>/dev/null; do sleep 5; done); cmd=(script -q /dev/null "${cmd[@]}"); fi
    ttl="${AGENT_CHAT_ENV_TTL:-60}"; case "$ttl" in ''|*[!0-9]*) ttl=60 ;; esac; [ "$ttl" -le 60 ] || ttl=60
    for c in $CHANNELS; do d="$(channel_dir "$c")"; mkdir -p "$d" && chmod 700 "$d" || refuse "cannot make $d"
      export "$(channel_state_env "$c")=$d"; rm -f "$d/bot.pid" "$d/.env"
      t="$("$H/bin/secret" "$(channel_secret "$c")" 2>/dev/null)" && [ -n "$t" ] || refuse "could not read the $c bot token: run bin/keys set $c"
      # the token goes to a 0600 file only (printf is a builtin: no argument of any process carries it)
      ( umask 077; printf '%s=%s\n' "$(channel_token_env "$c")" "$t" > "$d/.env" ) || { unset t; rm -f "$d/.env"; refuse "cannot write $d/.env"; }
      unset t
      # deleted once the plugin has read it (it writes bot.pid when it starts), or after the time limit
      ( exec </dev/null >/dev/null 2>&1; i=0; while [ "$i" -lt $((ttl * 2)) ] && [ ! -f "$d/bot.pid" ]; do sleep 0.5; i=$((i+1)); done; rm -f "$d/.env" ) &
    done
    # the forwarder: the agents' events to main reach the chat while the session lives (story C7)
    fe="${AGENT_CHAT_FORWARD_EVERY:-15}"; case "$fe" in ''|*[!0-9]*) fe=15 ;; esac
    if [ "$fe" -gt 0 ]; then ( exec </dev/null >/dev/null 2>&1; while kill -0 $$ 2>/dev/null; do sleep "$fe"; kill -0 $$ 2>/dev/null && "$H/bin/chat" forward; done ) & fi
    echo "$$ $(date -u +%Y-%m-%dT%H:%MZ)" > "$PIDF"; echo $$ > "$LOCK/pid"
    echo "chat: $NAME on $CHANNELS (pid $$, mode $MODE)" >&2
    # the lock stays with the session (same pid); it is stale once the session is gone
    if [ "$TTY" = 0 ]; then exec "${cmd[@]}" >/dev/null 2>&1; else exec "${cmd[@]}"; fi ;;
  stop) [ $# -eq 1 ] || usage
    if [ -f "$LA/$LABEL.plist" ]; then U="gui/$(id -u)"
      launchctl disable "$U/$LABEL" 2>/dev/null; launchctl bootout "$U/$LABEL" 2>/dev/null
      echo "disabled $LABEL (bin/schedule install enables it again)"; fi
    if p="$(running_pid)"; then kill "$p" 2>/dev/null; i=0
      while kill -0 "$p" 2>/dev/null; do i=$((i+1)); [ $i -lt 100 ] || { echo "chat: pid $p still runs after 10 s; the pid file is kept" >&2; exit 1; }; sleep 0.1; done
      rm -f "$PIDF"; rm -rf "$LOCK"; echo "stopped (pid $p)"
    else echo "not running"; fi ;;
  status) if [ "${2:-}" = --card ] && [ $# -eq 2 ]; then st=stopped; running_pid >/dev/null && st=running
      agents_view card "$NAME · $st"; exit; fi
    [ $# -eq 1 ] || usage
    if p="$(running_pid)"; then ok=1; for c in $CHANNELS; do connected "$c" 2>/dev/null || ok=0; done
      if [ "$ok" = 1 ]; then echo "$NAME: running (pid $p, since $(since))"; else echo "$NAME: running, channel not connected (pid $p, since $(since))"; fi
    else echo "$NAME: stopped"; fi
    for c in $CHANNELS; do case " $(channel_types) " in *" $c "*) ;; *) echo "$c: unknown channel type"; continue ;; esac
      if a="$(access_of "$c")"; then echo "$c: policy ${a% *}, groups: ${a#* }"; else echo "$c: not paired yet (bin/chat setup $c)"; fi; done ;;
  setup) [ $# -le 2 ] || usage; c="${2:-telegram}"
    case " $(channel_types) " in *" $c "*) ;; *) echo "chat: unknown channel type (known channel types: $(channel_types))" >&2; exit 2 ;; esac
    if "$H/bin/secret" --has "$(channel_secret "$c")" 2>/dev/null; then st="stored"; else st="missing"; fi
    cat <<EOF
Telegram for this hub's orchestrator ($(hub_name)); token: $st. Do these once, in your own terminal:
1. In Telegram, message @BotFather: /newbot, pick a name and a username ending in "bot". Copy the token it gives you.
2. bin/keys set telegram   (paste the token at the hidden prompt; never in a chat or a file)
3. Install bun (https://bun.sh; the plugin runs on it). In any claude session: /plugin install telegram@claude-plugins-official   (user scope)
4. bin/chat start   (in a Terminal at the hub root, the first time, so you can answer its prompts)
5. Message your bot in Telegram; it replies with a pairing code. In the session: /telegram:access pair <code>
6. Lock it to you: /telegram:access policy allowlist   (no groups: an unattended start refuses otherwise)
7. Send a test message from Telegram and check the session answers. Then quit it, set HUB_CHAT=telegram in hub.conf
   and run bin/schedule install, so launchd keeps it running. bin/chat status shows it.
This orchestrator's channel state stays in $(channel_dir "$c"), never in the shared ~/.claude/channels/$c.
EOF
    ;;
  agents) [ $# -eq 1 ] || usage; agents_view table "" ;;
  to) [ "${2:-}" = --sender ] && [ $# -eq 5 ] || usage; is_owner "$3" || exit 2
    if ! f="$(resolve "$4")"; then echo "chat: no single agent named '$4'; the agents:" >&2; agents_view table "" >&2; exit 2; fi
    "$H/bin/notify" --from main "$f" "$5" ;;
  forward) [ $# -eq 1 ] || usage; mkdir -p "$S/chat" && chmod 700 "$S/chat" || exit 1; FL="$S/chat/forward.lock"
    # one forwarder at a time; a lock whose holder is gone is taken over
    if ! mkdir "$FL" 2>/dev/null; then p="$(cat "$FL/pid" 2>/dev/null)"
      case "$p" in ''|*[!0-9]*) ;; *) kill -0 "$p" 2>/dev/null && exit 0 ;; esac
      rm -rf "${FL:?}"; mkdir "$FL" 2>/dev/null || exit 0; fi
    echo $$ > "$FL/pid"; trap 'rm -rf "${FL:?}"' EXIT
    out="$(ev_py outbox)" || { echo "chat: the event log is unreadable" >&2; exit 1; }
    while IFS="$(printf '\t')" read -r cur text; do [ -n "$cur" ] || continue
      printf '%s\n' "$text" | chat_send || exit 1
      ev_py ack $cur || exit 1
    done <<< "$out" ;;
  ask) [ $# -eq 2 ] && [ -n "$2" ] || usage; mkdir -p "$ASKS" && chmod 700 "$S/chat" || exit 1
    ref="$(python3 -I "$PY_CHAT" ref)" && [ -n "$ref" ] || exit 1; printf '%s\n' "$2" > "$ASKS/$ref"
    b="${AGENT_CHAT_BUTTONS:-$(channel_buttons "$(first_channel)")}"
    if [ "$b" = all ]; then printf '%s\n' "$2" | chat_send --buttons "$ref"
    else printf '%s\nreply 1 to approve, 2 to deny (ref %s)\n' "$2" "$ref" | chat_send; fi || { rm -f "${ASKS:?}/${ref:?}"; exit 1; }
    echo "$ref" ;;
  answer) [ "${2:-}" = --sender ] && [ $# -eq 4 ] || usage; is_owner "$3" || exit 2; a="$4"; ref=""
    if [[ "$a" =~ ^ask:(approve|deny):([a-z]{5})$ ]]; then v="${BASH_REMATCH[1]}"; ref="${BASH_REMATCH[2]}"
    elif [[ "$a" =~ ^[[:space:]]*(1|2|approve|deny|yes|no)([[:space:]]+([a-z]{5}))?[[:space:]]*$ ]]; then v="${BASH_REMATCH[1]}"; ref="${BASH_REMATCH[3]}"
    else echo "chat: not an answer (reply 1 to approve, 2 to deny)" >&2; exit 2; fi
    case "$v" in 1|approve|yes) v=approved ;; *) v=denied ;; esac
    p="$(pending)"
    if [ -z "$ref" ]; then set -- $p
      if [ $# -ne 1 ]; then
        if [ $# -eq 0 ]; then echo "chat: nothing is waiting for an answer" >&2; else echo "chat: more than one is waiting ($*); reply with the ref too: 1 <ref>" >&2; fi
        exit 2; fi
      ref="$1"; fi
    printf '%s\n' "$p" | grep -qx "$ref" || { echo "chat: no ask $ref is waiting" >&2; exit 2; }
    echo "$v $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$ASKS/$ref.answer"; q="$(head -1 "$ASKS/$ref")"
    "$H/bin/journal" . "chat: $v $ref: $q"; echo "$v $ref: $q" ;;
  asked) [ $# -eq 2 ] && [[ "$2" =~ ^[a-z]{5}$ ]] || usage; [ -f "$ASKS/$2" ] || { echo unknown; exit 2; }
    if [ -f "$ASKS/$2.answer" ]; then awk '{print $1; exit}' "$ASKS/$2.answer"; else echo pending; fi ;;
  *) usage ;;
esac

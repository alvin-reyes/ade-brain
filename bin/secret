#!/bin/bash
# bin/secret <name>: a secret from the macOS Keychain (service: HUB_KEYCHAIN_SERVICE, default the hub name), on stdout for $(...) use only.
#   --set <name>   store or replace it (reads the value from a hidden prompt; never from an argument)
#   --has <name>   exit 0 when stored, 1 when not (prints nothing)
#   --forget <name>, --list (names only)
# Never echo the value, write it to a file, or put it in a commit, log, URL or chat.
set -u; . "$(dirname "$0")/lib.sh"; SVC="$(keychain_service)"
case "${1:-}" in
  --set) [ -n "${2:-}" ] || exit 2; printf 'value for %s: ' "$2" >&2; read -rs v; echo >&2
    [ -n "$v" ] || { echo "empty; nothing stored" >&2; exit 1; }
    # on stdin (security -i), so the value is never in a process argument; read back, since -i can hide a failure
    q() { local s="${1//\\/\\\\}"; printf '"%s"' "${s//\"/\\\"}"; }
    printf 'add-generic-password -U -s %s -a %s -w %s\n' "$(q "$SVC")" "$(q "$2")" "$(q "$v")" | security -i >/dev/null 2>&1
    [ "$(security find-generic-password -s "$SVC" -a "$2" -w 2>/dev/null)" = "$v" ] || { unset v; echo "could not store $2 in the Keychain" >&2; exit 1; }
    unset v; echo "stored $2" >&2 ;;
  --has) [ -n "${2:-}" ] || exit 2; security find-generic-password -s "$SVC" -a "$2" >/dev/null 2>&1 ;;
  --forget) [ -n "${2:-}" ] || exit 2; security delete-generic-password -s "$SVC" -a "$2" >/dev/null 2>&1 && echo "forgot $2" >&2 ;;
  --list) security dump-keychain 2>/dev/null | awk -v s="$SVC" '/"svce"<blob>=/{x=($0 ~ "\"" s "\"")} x && /"acct"<blob>=/{gsub(/.*="|"$/,""); print; x=0}' | sort -u ;;
  ""|-*) echo "usage: bin/secret <name> | --set <name> | --has <name> | --forget <name> | --list" >&2; exit 2 ;;
  *) security find-generic-password -s "$SVC" -a "$1" -w 2>/dev/null || { echo "secret: $1 not stored (bin/secret --set $1)" >&2; exit 1; } ;;
esac
